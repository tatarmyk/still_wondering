[Unit]
Description=Still Wondering Essays (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/still_wondering
EnvironmentFile=/opt/still_wondering/.env
ExecStart=/opt/still_wondering/venv/bin/gunicorn -c gunicorn.conf.py "app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
